<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>MiftawerkUnlock</AssemblyName>
    <RootNamespace>MiftawerkUnlock</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Deterministic>true</Deterministic>

    <!-- KeePass loads a DLL plugin only if the product name is exactly "KeePass Plugin". -->
    <Product>KeePass Plugin</Product>
    <AssemblyTitle>Miftawerk Unlock</AssemblyTitle>
    <Description>Quick unlock for KeePass 2 with Windows Hello.</Description>
    <Company>SeeColors iT</Company>
    <Copyright>Copyright (c) 2026 SeeColors iT</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Isolated portable KeePass copy (never the installed one in Program Files).
         CI passes /p:KeePassDir=... pointing to the verified official KeePass ZIP. -->
    <TestKeePassDir>$(MSBuildThisFileDirectory)..\..\testenv\KeePass\</TestKeePassDir>
    <KeePassDir Condition="'$(KeePassDir)' == ''">$(TestKeePassDir)</KeePassDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>$(KeePassDir)KeePass.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.9169" />
  </ItemGroup>

  <Target Name="CopyToTestKeePass" AfterTargets="Build" Condition="Exists('$(TestKeePassDir)KeePass.exe')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TestKeePassDir)Plugins" />
  </Target>

</Project>
